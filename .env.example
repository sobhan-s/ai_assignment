# Environment 
ENVIRONMENT=development

#  PostgreSQL 
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=genai_assistant
POSTGRES_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/genai_assistant

#  Qdrant 
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents

# LLM Provider Selection 
# Pick one: ollama | openai | anthropic | groq | google
LLM_PROVIDER=groq

# Pick one: ollama | openai | google | huggingface  
EMBEDDING_PROVIDER=ollama

# Generation Parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

OPENAI_API_KEY=sk-....
OPENAI_LLM_MODEL=something
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

 
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_LLM_MODEL=claude-3-5-haiku-20241022

 
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-

GOOGLE_API_KEY=AIza...
GOOGLE_LLM_MODEL=gemini-2.0-flash
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
